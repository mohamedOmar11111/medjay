{
  "name": "medjay",
  "version": "0.1.10",
  "description": "Open, CLI-first, all-model growth agent harness with spend guardrails and approval-gated execution.",
  "license": "MIT",
  "author": "Mohamed Omar",
  "homepage": "https://github.com/mohamedOmar11111/medjay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedOmar11111/medjay.git"
  },
  "bugs": {
    "url": "https://github.com/mohamedOmar11111/medjay/issues"
  },
  "keywords": [
    "marketing",
    "growth",
    "ai-agent",
    "cli",
    "tui",
    "google-ads",
    "meta-ads",
    "seo",
    "guardrails",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "medjay": "dist/cli.js",
    "mdj": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE",
    "docs/SPEC.md",
    "docs/assets",
    "fixtures/etlaala-ksa"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx fixtures/generate-etlaala-ksa.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "dev": "tsx src/cli.ts",
    "spike:m0": "tsx spikes/m0-ai-sdk/spike.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@napi-rs/keyring": "^2.1.1",
    "@types/react": "^19.3.0",
    "ai": "^7.0.143",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
